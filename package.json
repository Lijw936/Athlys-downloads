{
  "name": "athlys-android",
  "version": "1.2.0",
  "private": true,
  "description": "Athlys mobile coaching app",
  "scripts": {
    "android:sync": "cap sync android",
    "build:web": "esbuild web/native-app.js --bundle --format=iife --outfile=web/native-app.bundle.js && esbuild web/intent-launcher.js --bundle --format=iife --outfile=web/intent-launcher.bundle.js && esbuild web/supabase-client.js --bundle --format=iife --outfile=web/supabase-client.bundle.js",
    "test:public-client": "node --test tests/athlys-external-rtc.test.cjs tests/athlys-offline-knowledge.test.cjs web/mobile-experience.test.cjs tests/athlys-external-https.test.mjs services/athlys-free-external/server.test.mjs",
    "test": "npm run test:public-client"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@supabase/supabase-js": "2.118.0",
    "@capgo/capacitor-health": "7.0.2",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/splash-screen": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "esbuild": "^0.25.11"
  },
  "overrides": {
    "tslib": "2.8.1"
  }
}
