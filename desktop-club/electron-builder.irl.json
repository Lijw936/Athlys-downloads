{
  "appId": "com.athlys.club.irl.lm",
  "productName": "Athlys Club LM IRL",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.cjs",
    "copy-web.cjs",
    "offline.html",
    "package.json",
    "athlys.ico",
    "web/**/*"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "athlys.ico",
    "artifactName": "Athlys-Club-${version}-${arch}.${ext}",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Athlys Club"
  },
  "portable": {
    "artifactName": "Athlys-Club-LM-IRL-Portable-${version}-${arch}.${ext}"
  },
  "extraMetadata": {
    "version": "1.2.5-irl",
    "name": "athlys-club-lm-irl",
    "fieldTrial": true,
    "generativeTrial": true
  }
}
