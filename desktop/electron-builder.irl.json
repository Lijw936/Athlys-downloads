{
  "appId": "com.athlys.desktop.irl",
  "productName": "Athlys IRL",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.cjs",
    "copy-web.cjs",
    "athlys.ico",
    "package.json",
    "athlys.icns",
    "offline.html",
    "web/**/*"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "athlys.ico",
    "artifactName": "Athlys-${version}-${arch}.${ext}",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Athlys"
  },
  "portable": {
    "artifactName": "Athlys-IRL-Portable-${version}-${arch}.${ext}"
  },
  "mac": {
    "category": "public.app-category.healthcare-fitness",
    "icon": "athlys.icns",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "artifactName": "Athlys-${version}-${arch}.${ext}",
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "extraMetadata": {
    "version": "1.2.3-irl",
    "name": "athlys-irl",
    "fieldTrial": true
  }
}
